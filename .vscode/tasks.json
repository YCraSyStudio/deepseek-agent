// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "pnpm: build",
			"type": "shell",
			"command": "corepack pnpm run build",
			"problemMatcher": "$tsc"
		},
		{
			"label": "pnpm: watch",
			"type": "shell",
			"command": "corepack pnpm run watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
