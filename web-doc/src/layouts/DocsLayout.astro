---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import {
  alternateEntries,
  canonicalPath,
  languageLabels,
  languages,
  navLabels,
  pageContent,
  pageSlugs,
  sectionAnchor,
  type Language,
  type PageSlug,
} from "../i18n";
import deepSeekIconUrl from "../assets/DeepSeekIcon.svg?url";

const { title, description, seoTitle, lang = "en", currentSlug } = Astro.props as {
  title: string;
  description: string;
  seoTitle?: string;
  lang?: Language;
  currentSlug?: PageSlug;
};

const tocItems = currentSlug
  ? pageContent[lang][currentSlug].sections.map((section) => ({
      href: `#${sectionAnchor(section.title)}`,
      label: section.title,
    }))
  : pageSlugs.map((slug) => ({
      href: canonicalPath(lang, slug),
      label: navLabels[lang][slug],
    }));

const quickStartSlugs: PageSlug[] = ["intro", "user-manual"];
const projectSlugs: PageSlug[] = ["changelog", "technical-decisions", "references"];

const productName = "YCraSy DeepSeek Agent";
const publisherName = "YCraSy Studio";
const publisherUrl = "https://github.com/YCraSyStudio";
const repositoryUrl = "https://github.com/YCraSyStudio/deepseek-agent";
const marketplaceUrl = "https://marketplace.visualstudio.com/items?itemName=yarcrasy.deepseek-agent";
function readExtensionManifest(): { version: string } {
  for (const candidate of ["../package.json", "package.json"]) {
    const manifestPath = resolve(process.cwd(), candidate);
    if (!existsSync(manifestPath)) {
      continue;
    }
    const parsed = JSON.parse(readFileSync(manifestPath, "utf8")) as { name?: string; version?: string };
    if (parsed.name === "deepseek-agent" && typeof parsed.version === "string") {
      return { version: parsed.version };
    }
  }
  throw new Error("Could not read the extension version from the repository manifest");
}

const manifest = readExtensionManifest();
const siteRoot = new URL(canonicalPath("en"), Astro.site ?? "https://ycrasystudio.github.io/");
const absoluteUrl = (path: string) => new URL(path, siteRoot).href;
const pageTitle = seoTitle ?? title;
const fullTitle = `${pageTitle} | ${productName}`;
const canonicalUrl = absoluteUrl(canonicalPath(lang, currentSlug));
const englishHomeUrl = absoluteUrl(canonicalPath("en"));
const ogImageUrl = absoluteUrl("og-image.png");
const iconPngUrl = absoluteUrl("icon-256.png");
const sitemapUrl = absoluteUrl("sitemap.xml");
const alternates = alternateEntries(currentSlug).map((entry) => ({ ...entry, href: absoluteUrl(entry.path) }));
const localeByLanguage: Record<Language, string> = { en: "en_US", es: "es_ES", zh: "zh_CN" };
const alternateLocales = languages.filter((item) => item !== lang).map((item) => localeByLanguage[item]);
const currentLabel = currentSlug ? navLabels[lang][currentSlug] : productName;

const publisherNode = {
  "@type": "Organization",
  "@id": `${englishHomeUrl}#publisher`,
  name: publisherName,
  url: publisherUrl,
  logo: { "@type": "ImageObject", url: iconPngUrl, width: 256, height: 256 },
};

const websiteNode = {
  "@type": "WebSite",
  "@id": `${englishHomeUrl}#website`,
  url: englishHomeUrl,
  name: productName,
  description: pageContent.en.intro.description,
  inLanguage: [...languages],
  publisher: { "@id": `${englishHomeUrl}#publisher` },
};

const applicationNode = {
  "@type": "SoftwareApplication",
  "@id": `${englishHomeUrl}#application`,
  name: productName,
  description,
  url: englishHomeUrl,
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Code editor extension",
  operatingSystem: "Windows, macOS, Linux",
  softwareVersion: manifest.version,
  softwareRequirements: "Visual Studio Code",
  downloadUrl: marketplaceUrl,
  installUrl: marketplaceUrl,
  sameAs: [marketplaceUrl, repositoryUrl],
  isAccessibleForFree: true,
  license: "https://opensource.org/license/mit",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  image: ogImageUrl,
  inLanguage: lang,
  publisher: { "@id": `${englishHomeUrl}#publisher` },
};

const articleNode = {
  "@type": "TechArticle",
  "@id": `${canonicalUrl}#article`,
  headline: pageTitle,
  name: pageTitle,
  description,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  inLanguage: lang,
  isPartOf: { "@id": `${englishHomeUrl}#website` },
  publisher: { "@id": `${englishHomeUrl}#publisher` },
  license: "https://opensource.org/license/mit",
};

const breadcrumbNode = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: productName, item: absoluteUrl(canonicalPath(lang)) },
    { "@type": "ListItem", position: 2, name: currentLabel, item: canonicalUrl },
  ],
};

const graph = [
  websiteNode,
  publisherNode,
  currentSlug ? articleNode : applicationNode,
  ...(currentSlug ? [breadcrumbNode] : []),
];
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="author" content={publisherName} />
    <meta name="theme-color" content="#1b1b1f" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <link rel="icon" href={deepSeekIconUrl} />
    <link rel="icon" type="image/png" sizes="256x256" href={iconPngUrl} />
    <link rel="apple-touch-icon" href={iconPngUrl} />
    <meta property="og:type" content={currentSlug ? "article" : "website"} />
    <meta property="og:site_name" content={productName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={productName} />
    <meta property="og:locale" content={localeByLanguage[lang]} />
    {alternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={productName} />
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={canonicalPath(lang)} aria-label="YCraSy DeepSeek Agent home">
        <img src={deepSeekIconUrl} alt="" width="28" height="28" />
        <span>YCraSy DeepSeek Agent</span>
      </a>
      <div class="topbarActions">
        <div class="languageSwitcher" aria-label="Language selector">
          {languages.map((item) => (
            <a
              class:list={[item === lang && "active"]}
              href={canonicalPath(item, currentSlug)}
              hreflang={item}
              aria-current={item === lang ? "page" : undefined}
            >
              {languageLabels[item]}
            </a>
          ))}
        </div>
        <a class="platformLink" href="https://platform.deepseek.com/" target="_blank" rel="noopener noreferrer">
          DeepSeek Platform
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="docsShell">
      <aside class="sidebar" aria-label="Documentation sections">
        <nav>
          <div class="navGroup">
            <p>Quick Start</p>
            <a
              class:list={["navRoot", !currentSlug && "active"]}
              href={canonicalPath(lang)}
              aria-current={!currentSlug ? "page" : undefined}>Overview</a
            >
            {quickStartSlugs.map((slug) => (
              <a
                class:list={[currentSlug === slug && "active"]}
                href={canonicalPath(lang, slug)}
                aria-current={currentSlug === slug ? "page" : undefined}
              >
                {navLabels[lang][slug]}
              </a>
            ))}
          </div>
          <div class="navGroup">
            <p>Project</p>
            {projectSlugs.map((slug) => (
              <a
                class:list={[currentSlug === slug && "active"]}
                href={canonicalPath(lang, slug)}
                aria-current={currentSlug === slug ? "page" : undefined}
              >
                {navLabels[lang][slug]}
              </a>
            ))}
          </div>
        </nav>
      </aside>

      <main class="content">
        <slot />
      </main>

      <aside class="toc" aria-label="On this page">
        <div class="tocPanel">
          {tocItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #1b1b1f;
    color: #ececf1;
    --bg: #1b1b1f;
    --panel: #202124;
    --panel-strong: #28282c;
    --border: #3a3a40;
    --border-soft: #303036;
    --text: #ececf1;
    --muted: #b8bac3;
    --dim: #8c8f99;
    --accent: #4aa8ff;
    --accent-soft: rgba(74, 168, 255, 0.12);
    --code: #2f3034;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 20px;
    border-bottom: 1px solid var(--border-soft);
    background: rgba(32, 33, 36, 0.96);
    backdrop-filter: blur(10px);
  }

  .brand,
  .topbarActions,
  .languageSwitcher {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
  }

  .brand img {
    display: block;
  }

  .topbarActions {
    gap: 16px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .languageSwitcher {
    gap: 4px;
  }

  .languageSwitcher a {
    border-radius: 5px;
    padding: 6px 8px;
  }

  .languageSwitcher a.active {
    background: var(--panel-strong);
    color: var(--text);
  }

  .platformLink {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .docsShell {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr) 260px;
    min-height: calc(100vh - 64px);
  }

  .sidebar,
  .toc {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow: auto;
  }

  .sidebar {
    border-right: 1px solid var(--border);
    background: #1f2024;
    padding: 16px 10px;
  }

  .navGroup {
    display: grid;
    gap: 4px;
  }

  .navGroup + .navGroup {
    margin-top: 18px;
  }

  .navGroup p {
    margin: 0 0 4px;
    padding: 0 10px;
    color: var(--accent);
    font-weight: 650;
  }

  .navGroup a {
    border-radius: 4px;
    color: #d7d8df;
    padding: 8px 12px;
    line-height: 1.35;
  }

  .navGroup a.navRoot {
    color: var(--accent);
    font-weight: 600;
  }

  .navGroup a.active {
    background: var(--panel-strong);
    color: var(--accent);
  }

  .content {
    width: min(100%, 1020px);
    padding: 28px clamp(28px, 5vw, 72px) 88px;
  }

  .toc {
    border-left: 1px solid var(--border-soft);
    padding: 28px 20px;
  }

  .tocPanel {
    display: grid;
    gap: 12px;
    border-left: 1px solid #5a5b63;
    padding-left: 16px;
    font-size: 0.9rem;
  }

  .tocPanel a {
    color: #d9dae1;
  }

  h1 {
    max-width: 820px;
    margin: 26px 0 20px;
    font-size: clamp(2.4rem, 6vw, 3.7rem);
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.05;
  }

  h2 {
    margin: 44px 0 14px;
    scroll-margin-top: 90px;
    font-size: 1.55rem;
    letter-spacing: 0;
  }

  p,
  li {
    line-height: 1.7;
  }

  .lead {
    max-width: 820px;
    color: #f0f0f3;
    font-size: 1.08rem;
  }

  .sectionList {
    display: grid;
    gap: 0;
    width: min(720px, 100%);
    margin-top: 30px;
    border: 1px solid var(--border);
  }

  .sectionList a {
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
  }

  .sectionList a:last-child {
    border-bottom: 0;
  }

  .sectionList strong {
    color: var(--accent);
  }

  .sectionList span {
    color: var(--muted);
  }

  section {
    max-width: 860px;
  }

  ul {
    padding-left: 20px;
  }

  li + li {
    margin-top: 8px;
  }

  code {
    border-radius: 4px;
    background: var(--code);
    padding: 0.12em 0.32em;
    color: #f4f4f6;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.92em;
  }

  .metadataTable {
    width: min(720px, 100%);
    margin: 28px 0;
    border-collapse: collapse;
    border: 1px solid #595a62;
  }

  .metadataTable th,
  .metadataTable td {
    padding: 14px 16px;
    border: 1px solid #595a62;
    text-align: left;
    vertical-align: top;
  }

  .metadataTable th {
    background: var(--panel-strong);
  }

  .metadataTable td {
    background: rgba(255, 255, 255, 0.02);
  }

  @media (max-width: 1100px) {
    .docsShell {
      grid-template-columns: 260px minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .topbar {
      position: static;
      align-items: flex-start;
      flex-direction: column;
      padding: 14px 16px;
    }

    .topbarActions {
      width: 100%;
      justify-content: space-between;
    }

    .docsShell {
      display: block;
    }

    .sidebar {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .navGroup {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .content {
      padding: 26px 18px 72px;
    }

    h1 {
      font-size: 2.35rem;
    }
  }

  @media (max-width: 520px) {
    .topbarActions,
    .languageSwitcher {
      align-items: flex-start;
      flex-direction: column;
    }

    .navGroup {
      grid-template-columns: 1fr;
    }
  }
</style>
