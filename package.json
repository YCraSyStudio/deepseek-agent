{
  "name": "deepseek-agent",
  "displayName": "YCraSy DeepSeek Agent",
  "description": "DeepSeek coding agent for VS Code: chat, tool calls, and autonomous workspace tasks powered by DeepSeek models.",
  "version": "0.1.16",
  "packageManager": "pnpm@12.15.0",
  "preview": true,
  "publisher": "yarcrasy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YCraSyStudio/deepseek-agent.git"
  },
  "homepage": "https://ycrasystudio.github.io/deepseek-agent/",
  "bugs": {
    "url": "https://github.com/YCraSyStudio/deepseek-agent/issues"
  },
  "icon": "src/assets/DeepSeekIcon.png",
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "agent",
    "ai",
    "assistant",
    "chat",
    "coding",
    "vscode"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "File, search, Git, and terminal tools require a local file-backed workspace."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat remains available, but workspace tools fail closed until the workspace is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "deepseek-agent.openChat",
        "title": "YCraSy DeepSeek Agent: Open Chat",
        "category": "YCraSy DeepSeek Agent"
      },
      {
        "command": "deepseek-agent.addFileToChat",
        "title": "YCraSy DeepSeek Agent: Add File to Chat",
        "category": "YCraSy DeepSeek Agent",
        "icon": "$(add)"
      },
      {
        "command": "deepseek-agent.addSelectionToChat",
        "title": "YCraSy DeepSeek Agent: Add Selection to Chat",
        "category": "YCraSy DeepSeek Agent",
        "icon": "$(add)"
      },
      {
        "command": "deepseek-agent.newChat",
        "title": "YCraSy DeepSeek Agent: New Chat",
        "category": "YCraSy DeepSeek Agent",
        "icon": "$(add)"
      },
      {
        "command": "deepseek-agent.reviewChanges",
        "title": "YCraSy DeepSeek Agent: Review Changes",
        "category": "YCraSy DeepSeek Agent",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "deepseek-agent.showDiagnostics",
        "title": "YCraSy DeepSeek Agent: Show Diagnostics",
        "category": "YCraSy DeepSeek Agent"
      },
      {
        "command": "deepseek-agent.clearDiagnostics",
        "title": "YCraSy DeepSeek Agent: Clear Diagnostics",
        "category": "YCraSy DeepSeek Agent"
      },
      {
        "command": "deepseek-agent.completeEditor",
        "title": "%editor.complete%",
        "category": "YCraSy DeepSeek Agent"
      },
      {
        "command": "deepseek-agent.refactorEditor",
        "title": "%editor.refactor%",
        "category": "YCraSy DeepSeek Agent"
      },
      {
        "command": "deepseek-agent.revertReviewedTurn",
        "title": "YCraSy DeepSeek Agent: Revert Turn",
        "category": "YCraSy DeepSeek Agent",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "deepseek-agent.addFileToChat",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "submenu": "deepseek-agent.editorActions",
          "when": "editorTextFocus && !editorReadonly",
          "group": "navigation@50"
        }
      ],
      "scm/title": [
        {
          "command": "deepseek-agent.reviewChanges",
          "group": "navigation@50"
        }
      ],
      "deepseek-agent.editorActions": [
        {
          "command": "deepseek-agent.completeEditor",
          "group": "1_code@1"
        },
        {
          "command": "deepseek-agent.refactorEditor",
          "group": "1_code@2"
        },
        {
          "command": "deepseek-agent.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "2_context@0"
        },
        {
          "command": "deepseek-agent.reviewChanges",
          "when": "resourceScheme == file",
          "group": "2_context@1"
        }
      ],
      "editor/title": [
        {
          "command": "deepseek-agent.revertReviewedTurn",
          "when": "resourceScheme == ycrasy-change",
          "group": "navigation@50"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-agent-sidebar",
          "title": "YCraSy DeepSeek Agent",
          "icon": "src/assets/DeepSeekIcon.svg"
        }
      ]
    },
    "views": {
      "deepseek-agent-sidebar": [
        {
          "type": "webview",
          "id": "deepseek-agent.chatView",
          "name": "Chat",
          "icon": "src/assets/DeepSeekIcon.svg",
          "visibility": "visible"
        }
      ]
    },
    "submenus": [
      {
        "id": "deepseek-agent.editorActions",
        "label": "YCraSy DeepSeek Agent"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "compile": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./ --noEmit",
    "audit:dead-code": "knip --no-progress",
    "build": "node esbuild.js --production && vite build --config src/ui/vite.config.mts",
    "build:extension": "node esbuild.js --production",
    "build:webview": "vite build --config src/ui/vite.config.mts",
    "dev:webview": "vite --config src/ui/vite.config.mts --host 0.0.0.0 --port 5175 --strictPort",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "prepare:integration": "pnpm run build && node scripts/build-integration-tests.mjs",
    "test:integration": "pnpm run prepare:integration && vscode-test",
    "package:vsix": "node scripts/prepare-artifacts.mjs && vsce package --no-dependencies --out artifacts",
    "verify:vsix": "node scripts/assert-vsix-contents.mjs"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "@vscode/codicons": "^0.0.45",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tldts": "^7.4.19",
    "proxy-agent": "^8.0.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.125.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.1.4",
    "mocha": {
      "glob": "13.0.6"
    },
    "@azure/identity": {
      "@azure/msal-node": "7.1.1"
    },
    "get-uri": {
      "basic-ftp": "6.2.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
